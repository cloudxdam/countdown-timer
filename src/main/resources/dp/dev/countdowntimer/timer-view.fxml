<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.chart.BubbleChart?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.shape.Sphere?>
<?import javafx.scene.layout.HBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="dp.dev.countdowntimer.controller.TimerController">

    <HBox spacing="10.0" alignment="CENTER">
        <VBox>
            <Label text="minutes"/>
            <Spinner fx:id="minutesSpinner"/>
        </VBox>
        <VBox>
            <Label text="seconds"/>
            <Spinner fx:id="secondsSpinner"/>
        </VBox>
    </HBox>

    <HBox spacing="10.0" alignment="CENTER">
        <Button fx:id="actionButton" text="start!" onAction="#handleAction"/>
        <Button text="reset" onAction="#handleReset"/>
    </HBox>

    <Label fx:id="timerLabel" text="00:00"/>
</VBox>
